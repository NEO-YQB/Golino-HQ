# Server Environment
NODE_ENV=production
PORT=3005

# PostgreSQL Database Connection
# مقدار را از پنل Coolify در بخش New Resource > PostgreSQL کپی کنید:
DATABASE_URL=postgresql://postgres:password@localhost:5432/golino_hq_db?schema=public

# AI API Key (Gemini for Dept Managers & Boardroom discussion)
# دریافت رایگان از https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Host URL
NEXT_PUBLIC_APP_URL=https://hq.golino.shop
